# local | integration | production
API_ENV=local
API_HOST=127.0.0.1
API_PORT=8787
API_DB_PATH=

# Local demo keeps one isolated demo user. For a real app, use service-token
# behind your own authenticated backend/gateway and forward a trusted X-User-Id.
API_AUTH_MODE=demo
API_SERVICE_TOKEN=

CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
API_REQUIRE_IDEMPOTENCY=false
API_IDEMPOTENCY_TTL_HOURS=168

# Real itinerary Agent. Keep the API key server-side. With only
# OPENAI_API_KEY + OPENAI_MODEL=kimi, the service uses Moonshot Chat
# Completions at https://api.moonshot.cn/v1 with model kimi-k2.6.
# OPENAI_AGENT_MODEL and OPENAI_BASE_URL remain optional explicit overrides.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_AGENT_MODEL=
OPENAI_BASE_URL=
AGENT_PROVIDER_TIMEOUT_MS=45000

# Hackathon helper: best-effort public title/summary preview for official
# Xiaohongshu share URLs. It never uses cookies, runs JavaScript, or downloads
# the note body/images. Production defaults to disabled until a formal provider
# contract replaces this demo resolver.
XHS_PUBLIC_METADATA_ENABLED=true
XHS_PUBLIC_METADATA_TIMEOUT_MS=3500
XHS_PUBLIC_METADATA_MAX_BYTES=524288
XHS_PUBLIC_METADATA_MAX_REDIRECTS=3

API_REQUEST_TIMEOUT_MS=15000
API_HEADERS_TIMEOUT_MS=10000
API_KEEP_ALIVE_TIMEOUT_MS=5000
API_SHUTDOWN_TIMEOUT_MS=10000

# Generated only by the local launcher. Do not commit or reuse it.
API_SHUTDOWN_TOKEN=

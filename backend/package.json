{
  "name": "knot-travel-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.local src/server.js",
    "dev": "node --env-file-if-exists=.env.local --watch src/server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "db:backup": "node scripts/db-backup.js",
    "db:check": "node scripts/db-check.js"
  }
}

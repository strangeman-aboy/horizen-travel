# Browser-side Baidu Maps JavaScript API key. Restrict its allowed domains in
# the Baidu console. This value is visible to browsers by design.
VITE_BAIDU_MAP_AK=

# Vite development only. Production builds always call the same-origin /api/v1
# proxy and ignore this override.
VITE_API_BASE_URL=http://127.0.0.1:8787

# Sites Worker runtime bindings. Configure these in Sites, never in a VITE_*
# variable and never commit real values.
API_ORIGIN=
API_SERVICE_TOKEN=
SESSION_SIGNING_KEY=
